# Required
API_TOKEN=your-secret-token

# Notes root — the Markdown vault served read-only in the Notes tab
NOTES_ROOT=$HOME/path/to/your/notes

# Code sandbox (the Code tab is behind SHOW_CODE_TAB and off by default)
# CODE_ROOT limits the file tree; SANDBOX_PYTHON should be a venv that has
# numpy/matplotlib if you want plots back from the kernel.
CODE_ROOT=$HOME/path/to/your/code
SANDBOX_PYTHON=$HOME/path/to/sandbox-venv/bin/python3

# TTS engine: edge (free) or openai (paid, stable)
TTS_ENGINE=edge
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_VOICE_EN=en-US-JennyNeural

# Optional: OpenAI for Whisper API + OpenAI TTS
# OPENAI_API_KEY=sk-...
# WHISPER_API_MODEL=whisper-1
# OPENAI_TTS_VOICE=nova

# Port
PORT=8765

# Jupyter integration (optional)
# Token must match the --NotebookApp.token= flag on your jupyter-notebook command
# JUPYTER_TOKEN=your-jupyter-token
# JUPYTER_BASE_URL=/jupyter/

# Public origin of the deployed site (CORS + served image URLs)
PUBLIC_BASE_URL=https://your-site.example.com
