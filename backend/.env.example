# Required
API_TOKEN=your-secret-token

# Notes root — all file operations are scoped here
NOTES_ROOT=/Users/you

# TTS engine: edge (free) or openai (paid, stable)
TTS_ENGINE=edge
TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
TTS_VOICE_EN=en-US-JennyNeural

# Optional: OpenAI for Whisper API + OpenAI TTS
# OPENAI_API_KEY=sk-...
# WHISPER_API_MODEL=whisper-1
# OPENAI_TTS_VOICE=nova

# Port
PORT=8765
