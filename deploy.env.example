# Copy to deploy.env (gitignored) and fill in your own values.

# SSH target for the VPS that serves the built frontend
VPS=root@your-vps.example.com

# Where the static build is rsync'd to on the VPS
WEB_ROOT=/var/www/butter-notebooks

# Public URL of the deployed site (printed after deploy)
SITE_URL=https://your-site.example.com

# SSH key used for the rsync/ssh calls
SSH_KEY=$HOME/.ssh/id_ed25519

# launchd label for the local backend
PLIST_LABEL=ai.openclaw.butter-notebooks
