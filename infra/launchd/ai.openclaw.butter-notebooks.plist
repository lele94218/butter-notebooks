<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CLAUDE_BIN</key>
		<string>/opt/homebrew/bin/claude</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>ai.openclaw.butter-notebooks</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/butter-notebooks/infra/launchd/butter-notebooks-launcher.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/butter-notebooks.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/butter-notebooks.log</string>
	<key>WorkingDirectory</key>
	<string>/path/to/butter-notebooks/backend</string>
</dict>
</plist>
