<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.butter-jupyter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/works/ComfyUI/venv/bin/jupyter-notebook</string>
        <string>--notebook-dir=/Users/you/works/deep-learnings/d2l</string>
        <string>--ip=YOUR.MAC.TAILSCALE.IP</string>
        <string>--NotebookApp.token=YOUR_JUPYTER_TOKEN</string>
        <string>--NotebookApp.password=</string>
        <string>--NotebookApp.base_url=/jupyter/</string>
        <string>--NotebookApp.allow_origin=https://your-site.example.com</string>
        <string>--NotebookApp.tornado_settings={"headers":{"Content-Security-Policy":"frame-ancestors https://your-site.example.com"}}</string>
        <string>--no-browser</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/you/works/deep-learnings/d2l</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/butter-jupyter.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/butter-jupyter.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
